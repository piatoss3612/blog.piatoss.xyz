---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  publishedTime,
  noindex = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImage = new URL("/og-cover.jpg", SITE.url);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Diphylleia&family=Outfit:wght@400;500;600;700;800&family=Noto+Serif+KR:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a class="wordmark" href="/" aria-label="piatoss.log 홈">piatoss<span class="accent">.log</span></a>
        <div class="nav-links">
          <a href="/writing" aria-current={path.startsWith("/writing") ? "page" : undefined}>새 글</a>
          <a href="/archive" aria-current={path.startsWith("/archive") ? "page" : undefined}>아카이브</a>
          <a href="/notes" aria-current={path.startsWith("/notes") ? "page" : undefined}>혼잣말</a>
          <a href="/categories" aria-current={path.startsWith("/categories") ? "page" : undefined}>카테고리</a>
          <a href={SITE.portfolio} target="_blank" rel="noopener">piatoss.xyz ↗</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </nav>
    </header>
    <slot name="hero" />
    <main class="shell">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="lantern-road" role="presentation"></div>
      <div class="footer-inner">
        <p class="tagline">Wallets, Zcash, and strange little interfaces.</p>
        <p class="fine">© {new Date().getFullYear()} piatoss · <a href={SITE.portfolio}>piatoss.xyz</a></p>
      </div>
    </footer>
  </body>
</html>

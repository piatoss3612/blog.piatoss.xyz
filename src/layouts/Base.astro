---
import "../styles/fonts.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { SITE } from "../lib/site";
// 어느 페이지든 본문에 바로 쓰이는 두 개만 미리 받는다. 라틴은 Outfit, 한글은 Plex KR로
// 떨어지므로 둘 다 필요하다. 나머지 웨이트는 CSS가 파싱되면서 알아서 따라온다.
// 해시가 붙은 실제 URL이 필요해서 import로 받는다 — 경로를 문자열로 적으면 캐시가 안 갈린다.
import outfitBody from "../assets/fonts/outfit-400.woff2";
import plexBody from "../assets/fonts/plex-kr-400.woff2";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  noindex?: boolean;
  /** 글 페이지는 제목이 박힌 전용 카드를 넘긴다. 나머지는 공통 커버를 쓴다. */
  ogImage?: string;
}

const {
  title,
  description = SITE.description,
  ogType = "website",
  publishedTime,
  noindex = false,
  ogImage: ogImagePath = "/og-cover.jpg",
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);
const ogImage = new URL(ogImagePath, SITE.url);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* 폰트는 crossorigin 없이 preload하면 요청이 두 번 나간다 — 같은 출처라도 그렇다 */}
    <link rel="preload" href={outfitBody} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexBody} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ko_KR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">본문 바로가기</a>
    <header class="site-header">
      <nav>
        <a class="wordmark" href="/" aria-label="piatoss.log 홈">piatoss<span class="accent">.log</span></a>
        <div class="nav-links">
          <a href="/writing" aria-current={path.startsWith("/writing") ? "page" : undefined}>기록</a>
          <a href="/notes" aria-current={path.startsWith("/notes") ? "page" : undefined}>조각</a>
          <a href="/archive" aria-current={path.startsWith("/archive") ? "page" : undefined}>아카이브</a>
          <a href="/categories" aria-current={path.startsWith("/categories") ? "page" : undefined}>카테고리</a>
          <a href="/search" aria-current={path.startsWith("/search") ? "page" : undefined}>검색</a>
          <a href="/about" aria-current={path.startsWith("/about") ? "page" : undefined}>소개</a>
        </div>
      </nav>
      <img class="header-lantern" src="/bremen/lantern.webp" alt="" aria-hidden="true" />
    </header>
    <slot name="hero" />
    <main class="shell" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="lantern-road" role="presentation">
        <img class="road-walker" src="/piatoss-squirrel.webp" alt="" aria-hidden="true" loading="lazy" />
        <span class="firefly f5"></span>
        <span class="firefly f6"></span>
      </div>
      <div class="footer-inner">
        <p class="tagline">Wallets and strange little interfaces.</p>
        <p class="fine">
          © {new Date().getFullYear()} piatoss · <a href={SITE.portfolio}>piatoss.xyz</a> · <a href="/rss.xml">RSS</a>
        </p>
      </div>
    </footer>
  </body>
</html>

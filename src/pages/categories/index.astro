---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { mainCategory, categorySlug } from "../../lib/site";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const counts = new Map<string, { name: string; slug: string; count: number }>();
for (const post of posts) {
  const name = mainCategory(post.data.category);
  const slug = categorySlug(post.data.category);
  const entry = counts.get(slug) ?? { name, slug, count: 0 };
  entry.count += 1;
  counts.set(slug, entry);
}
const categories = [...counts.values()].sort((a, b) => b.count - a.count);
---

<Base title="카테고리">
  <section class="hero">
    <h1>카테고리</h1>
  </section>
  <ul class="cat-grid">
    {
      categories.map((cat) => (
        <li>
          <a href={`/categories/${cat.slug}/`}>
            {cat.name}
            <span class="count">{cat.count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE } from "../lib/site";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const written = posts.filter((p) => p.data.tistoryId === undefined).length;
const archived = posts.filter((p) => p.data.tistoryId !== undefined).length;
---

<Base title="소개" description="미니맵의 안개를 구석구석 걷어내는 자.">
  <section class="hero about-hero">
    <h1>소개</h1>
    <p>미니맵의 안개를 구석구석 걷어내는 자.</p>
  </section>

  <dl class="about-map">
    <div>
      <dt><a href="/writing">기록</a></dt>
      <dd>여기서 쓴 글 {written}편</dd>
    </div>
    <div>
      <dt><a href="/notes">조각</a></dt>
      <dd>문장과 잡생각</dd>
    </div>
    <div>
      <dt><a href="/archive">아카이브</a></dt>
      <dd>티스토리에서 옮겨온 {archived}편</dd>
    </div>
  </dl>

  <p class="about-links">
    <a href={SITE.portfolio} target="_blank" rel="noopener">piatoss.xyz ↗</a>
    <a href={SITE.github} target="_blank" rel="noopener">GitHub ↗</a>
    <a href="/rss.xml">RSS</a>
  </p>
</Base>

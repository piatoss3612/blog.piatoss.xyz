---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// 색인 범위를 말해 두는 편이 낫다. 조각(notes)은 색인하지 않으니 여기 세지 않는다.
const indexed = (await getCollection("posts", ({ data }) => !data.draft)).length;
---

<Base title="검색" description="글 검색.">
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script slot="head" is:inline src="/pagefind/pagefind-ui.js"></script>

  <section class="hero search-hero">
    <h1>검색</h1>
    <p>글 {indexed}편에서 찾습니다. <a href="/archive">아카이브</a> · <a href="/categories">카테고리</a></p>
  </section>

  <div id="search" class="pagefind-wrap"></div>

  <script is:inline>
    // Pagefind 색인은 빌드 후에 생성되므로 개발 서버에서는 동작하지 않는다.
    // ClientRouter를 쓰기 때문에 astro:page-load에서도 초기화해야 한다.
    function initSearch() {
      const el = document.querySelector("#search");
      if (!el || el.dataset.ready || typeof PagefindUI === "undefined") return;
      el.dataset.ready = "1";
      new PagefindUI({
        element: "#search",
        showSubResults: true,
        showImages: false,
        translations: {
          placeholder: "글 검색",
          clear_search: "지우기",
          load_more: "더 보기",
          search_label: "이 블로그 검색",
          zero_results: "[SEARCH_TERM] — 결과가 없습니다",
          many_results: "[SEARCH_TERM] — [COUNT]편",
          one_result: "[SEARCH_TERM] — 1편",
          searching: "[SEARCH_TERM] 찾는 중",
        },
      });
    }
    document.addEventListener("astro:page-load", initSearch);
    initSearch();
  </script>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { dayKey, dateDot } from "../lib/format";
import { categorySlug, mainCategory } from "../lib/site";

const posts = (
  await getCollection("posts", ({ data }) => !data.draft && data.tistoryId === undefined)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="기록" description="이 블로그에서 쓴 글.">
  <section class="hero">
    <h1>기록</h1>
    <p>이 블로그에서 쓴 글 {posts.length}편.</p>
  </section>

  <ul class="post-list">
    {
      posts.map((post) => (
        <li>
          <time class="post-date" datetime={dayKey(post.data.date)}>{dateDot(post.data.date)}</time>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <a class="post-cat" href={`/categories/${categorySlug(post.data.category)}/`}>
            {mainCategory(post.data.category)}
          </a>
        </li>
      ))
    }
  </ul>
</Base>

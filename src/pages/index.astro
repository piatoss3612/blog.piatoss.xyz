---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE, mainCategory, categorySlug } from "../lib/site";
import { dateDot, dateKorean, readingMinutes } from "../lib/format";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [latest, ...rest] = posts;
const recent = rest.slice(0, 14);
---

<Base>
  <section slot="hero" class="hero-scene">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>piatoss<span class="accent">.log</span></h1>
        <p>{SITE.tagline}</p>
      </div>
      <img class="hero-ledger night-only" src="/bremen/ledger.webp" alt="" aria-hidden="true" />
    </div>
    <span class="firefly f1 night-only"></span>
    <span class="firefly f2 night-only"></span>
    <span class="firefly f3 night-only"></span>
    <span class="firefly f4 night-only"></span>
  </section>

  {
    latest && (
      <a class="featured" href={`/posts/${latest.id}/`}>
        <p class="featured-label">가장 최근의 기록</p>
        <h2 class="featured-title">{latest.data.title}</h2>
        {latest.data.description && <p class="featured-desc">{latest.data.description}</p>}
        <p class="featured-meta">
          {dateKorean(latest.data.date)} · {mainCategory(latest.data.category)} · 약{" "}
          {readingMinutes(latest.body)}분
        </p>
      </a>
    )
  }

  <p class="section-label">지난 기록</p>
  <ul class="post-list">
    {
      recent.map((post) => (
        <li>
          <span class="post-date">{dateDot(post.data.date)}</span>
          <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          <a class="post-cat" href={`/categories/${categorySlug(post.data.category)}/`}>
            {mainCategory(post.data.category)}
          </a>
        </li>
      ))
    }
  </ul>
  <p style="margin-top: 1.4rem;">
    <a href="/archive">전체 {posts.length}편 아카이브 →</a>
  </p>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE, mainCategory, categorySlug } from "../lib/site";
import { dayKey, dateDot, dateKorean, readingMinutes } from "../lib/format";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const currentPosts = posts.filter((post) => post.data.tistoryId === undefined);
const archivePosts = posts.filter((post) => post.data.tistoryId !== undefined);
const firstArchiveYear = dayKey(archivePosts.at(-1)!.data.date).slice(0, 4);
const [latest, ...recent] = currentPosts;
// NEW는 2주까지만. 영영 붙어 있으면 "새 글"이 아니라 장식이 된다
const isNew = latest !== undefined && Date.now() - latest.data.date.valueOf() < 14 * 86_400_000;
const archivePreview = archivePosts.slice(0, 5);

// 글 페이지에는 BlogPosting이 있지만 블로그와 사람 자체를 말해 주는 자리는 홈뿐이다.
// sameAs에는 내가 실제로 관리하는 곳만 적는다 — 링크가 하나라도 어긋나면 전체 신뢰도가 깎인다.
const person = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: "piatoss (Rowan)",
  url: SITE.portfolio,
  sameAs: [SITE.portfolio, SITE.github],
};
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    person,
    {
      "@type": "Blog",
      "@id": `${SITE.url}/#blog`,
      name: SITE.title,
      description: SITE.description,
      url: `${SITE.url}/`,
      inLanguage: "ko",
      author: { "@id": `${SITE.url}/#person` },
      publisher: { "@id": `${SITE.url}/#person` },
    },
  ],
});
---

<Base>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  <section slot="hero" class="hero-scene">
    <div class="hero-inner">
      <div class="hero-text">
        <h1>piatoss<span class="accent">.log</span></h1>
        <p>{SITE.tagline}</p>
      </div>
      <img class="hero-ledger" src="/bremen/ledger.webp" alt="" aria-hidden="true" />
    </div>
    <span class="firefly f1"></span>
    <span class="firefly f2"></span>
    <span class="firefly f3"></span>
    <span class="firefly f4"></span>
  </section>

  <section class="current-section" aria-labelledby="current-heading">
    <header class="current-section-header">
      <h2 class="section-label" id="current-heading">최근 기록</h2>
      {/* 글이 하나뿐이면 아래 카드가 곧 전부다. 같은 글로 데려가는 링크는 뺀다 */}
      {currentPosts.length > 1 && <a href="/writing">기록 모두 보기 →</a>}
    </header>
    {
      latest && (
        <a class="featured" href={`/posts/${latest.id}/`}>
          {isNew && <p class="featured-label">NEW</p>}
          <h3 class="featured-title">{latest.data.title}</h3>
          {latest.data.description && <p class="featured-desc">{latest.data.description}</p>}
          <p class="featured-meta">
            {dateKorean(latest.data.date)} · {mainCategory(latest.data.category)} · 약{" "}
            {readingMinutes(latest.body)}분
          </p>
        </a>
      )
    }
    {
      recent.length > 0 && (
        <ul class="post-list">
          {recent.map((post) => (
            <li>
              <time class="post-date" datetime={dayKey(post.data.date)}>{dateDot(post.data.date)}</time>
              <a href={`/posts/${post.id}/`}>{post.data.title}</a>
              <a class="post-cat" href={`/categories/${categorySlug(post.data.category)}/`}>
                {mainCategory(post.data.category)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="archive-section" aria-labelledby="archive-heading">
    <header class="archive-section-header">
      <h2 id="archive-heading">아카이브</h2>
      {/* 아카이브 페이지와 같은 말을 쓴다. "이전 기록"은 이 목록이 어디서 왔는지 말해 주지 않는다 */}
      <p>티스토리에서 옮겨 온 {firstArchiveYear}년 이후의 기록 {archivePosts.length}편</p>
    </header>
    <ul class="post-list">
      {
        archivePreview.map((post) => (
          <li>
            <time class="post-date" datetime={dayKey(post.data.date)}>{dateDot(post.data.date)}</time>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
            <a class="post-cat" href={`/categories/${categorySlug(post.data.category)}/`}>
              {mainCategory(post.data.category)}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="archive-link">
      <a href="/archive">전체 {archivePosts.length}편 아카이브 →</a>
    </p>
  </section>
</Base>

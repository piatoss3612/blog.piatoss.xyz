---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { categorySlug } from "../../lib/site";
import { dateKorean, readingMinutes } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => {
    const isArchive = post.data.tistoryId !== undefined;
    const siblings = posts
      .filter((candidate) => (candidate.data.tistoryId !== undefined) === isArchive)
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
    const index = siblings.findIndex((candidate) => candidate.id === post.id);
    return {
      params: { id: post.id },
      props: { post, prev: siblings[index - 1] ?? null, next: siblings[index + 1] ?? null },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
// 에세이는 본문까지 세리프로 — 기술 글은 산세리프 유지
const isEssay = post.data.category.startsWith("생각 정리");

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  inLanguage: "ko",
  author: { "@type": "Person", name: "piatoss (Rowan)", url: "https://piatoss.xyz" },
  image: "https://blog.piatoss.xyz/og-cover.jpg",
  mainEntityOfPage: `https://blog.piatoss.xyz/posts/${post.id}/`,
});
---

<Base
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.date.toISOString()}
>
  <script slot="head" type="application/ld+json" set:html={jsonLd} />
  {/* data-pagefind-body가 있는 페이지만 색인된다 — 목록·카테고리 페이지는 검색에 안 걸린다 */}
  <article data-pagefind-body>
    <header class="post-header">
      {/* 읽는 시간·링크 복사 버튼이 검색 발췌문에 섞이지 않게 색인에서 뺀다 */}
      <div class="post-meta" data-pagefind-ignore>
        <time datetime={post.data.date.toISOString()}>{dateKorean(post.data.date)}</time>
        {
          post.data.category && (
            <a href={`/categories/${categorySlug(post.data.category)}/`}>{post.data.category}</a>
          )
        }
        <span>약 {readingMinutes(post.body)}분</span>
        <button class="copy-link" type="button" data-copy-link>링크 복사</button>
      </div>
      <h1>{post.data.title}</h1>
      <div class="post-rule" role="presentation"></div>
    </header>
    <div class:list={["prose", { "prose-essay": isEssay }]}>
      <Content />
    </div>
    <div class="post-end" role="presentation">
      <img src="/bremen/ledger.webp" alt="" loading="lazy" />
    </div>
    <script>
      import mediumZoom from "medium-zoom";

      function initCodeCopy() {
        document.querySelectorAll<HTMLPreElement>(".prose pre.astro-code").forEach((pre) => {
          if (pre.parentElement?.classList.contains("code-wrap")) return;
          const wrap = document.createElement("div");
          wrap.className = "code-wrap";
          pre.replaceWith(wrap);
          wrap.appendChild(pre);
          const btn = document.createElement("button");
          btn.className = "code-copy";
          btn.type = "button";
          btn.textContent = "복사";
          btn.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(pre.innerText);
              btn.textContent = "복사됨 ✓";
              setTimeout(() => (btn.textContent = "복사"), 1600);
            } catch {
              btn.textContent = "실패";
            }
          });
          wrap.appendChild(btn);
        });
      }

      function initLinkCopy() {
        document.querySelectorAll<HTMLButtonElement>("[data-copy-link]").forEach((btn) => {
          if (btn.dataset.bound) return;
          btn.dataset.bound = "1";
          btn.addEventListener("click", async () => {
            const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]');
            try {
              await navigator.clipboard.writeText(canonical?.href ?? location.href);
              btn.textContent = "복사됨 ✓";
              setTimeout(() => (btn.textContent = "링크 복사"), 1600);
            } catch {
              btn.textContent = "실패";
            }
          });
        });
      }

      // astro:page-load는 최초 로드와 ClientRouter 전환 모두에서 발생한다
      document.addEventListener("astro:page-load", () => {
        mediumZoom(".prose img", { background: "rgba(12, 10, 8, 0.93)", margin: 28 });
        initCodeCopy();
        initLinkCopy();
      });
    </script>
    <nav class="post-footer-nav" data-pagefind-ignore>
      {
        prev ? (
          <a class="pn-card" href={`/posts/${prev.id}/`}>
            <span class="pn-label">← 이전 기록</span>
            <span class="pn-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pn-card pn-next" href={`/posts/${next.id}/`}>
            <span class="pn-label">다음 기록 →</span>
            <span class="pn-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

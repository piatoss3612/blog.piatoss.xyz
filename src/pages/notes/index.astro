---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { dateDot } from "../../lib/format";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// 목록에서 전문을 보여 주는 구조라 각 항목을 미리 렌더해 둔다.
const entries = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<Base title="조각" description="조각." noindex>
  <section class="hero notes-hero">
    <h1>조각</h1>
  </section>

  {
    entries.length > 0 ? (
      <ol class="notes-stream">
        {entries.map(({ note, Content }) => (
          <li>
            <article class="note-entry" id={note.id}>
              <header class="note-head">
                <time datetime={note.data.date.toISOString()}>{dateDot(note.data.date)}</time>
                <a
                  class="note-permalink"
                  href={`/notes/${note.id}/`}
                  aria-label={`${dateDot(note.data.date)} 조각 따로 보기`}
                >
                  #
                </a>
              </header>
              {note.data.title && <h2 class="note-title">{note.data.title}</h2>}
              <div class="prose prose-essay note-body">
                <Content />
              </div>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="notes-empty">아직 없음.</p>
    )
  }
</Base>

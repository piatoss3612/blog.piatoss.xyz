---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { dateKorean } from "../../lib/format";
import { citation, commentParagraphs, noteDatetime, noteLabel, sourceTitle } from "../../lib/notes";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);

// 문서 제목(탭·공유 카드)일 뿐 화면에 뜨는 제목이 아니다.
// 제목 없는 조각은 날짜가 그 노릇을 한다. 같은 날 여러 개를 올리면 그것만으로는
// 서로 구분되지 않아서 시각까지 붙인다. 발췌는 날짜 대신 출처를 쓴다.
const stamp = note.data.time
  ? `${dateKorean(note.data.date)} ${note.data.time}`
  : dateKorean(note.data.date);
const docTitle = note.data.title ?? (note.data.source ? sourceTitle(note.data.source) : stamp);
---

<Base
  title={docTitle}
  description="정리되기 전의 말."
  ogType="article"
  publishedTime={noteDatetime(note)}
  noindex
>
  <article class="note-single">
    <header class="note-head">
      <time datetime={noteDatetime(note)}>{noteLabel(note)}</time>
    </header>
    {note.data.title && <h1 class="note-title">{note.data.title}</h1>}
    <div class:list={["prose prose-essay note-body", note.data.source && "note-excerpt"]}>
      <Content />
    </div>
    {
      note.data.source && (
        <p class="note-source">
          <cite>{citation(note.data.source)}</cite>
        </p>
      )
    }
    {
      note.data.comment && (
        <div class="note-comment">
          {commentParagraphs(note).map((para) => (
            <p>{para}</p>
          ))}
        </div>
      )
    }
    <p class="note-back"><a href="/notes">← 조각으로 돌아가기</a></p>
  </article>
</Base>
